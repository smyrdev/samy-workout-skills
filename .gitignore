# The personal profile is user data, never committed.
# The schema lives at skills/onboarding/examples/profile.example.json instead.
profile/*
!profile/.gitkeep

# Exercise dataset clones are a local cache, described by skills/generation/datasets.json.
datasets/

__pycache__/
*.pyc

.todos.md

# eval results, generated on every run, not committed
/evals/results/
