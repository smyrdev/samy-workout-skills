# The personal profile is user data, never committed.
# A copy-to-start sample lives at skills/onboarding/assets/examples/profile.example.json instead.
profile/*
!profile/.gitkeep

# Exercise dataset clones are a local cache, described by skills/generation/assets/datasets.json.
datasets/

# Eval run outputs (skill-creator workspaces: iteration-N/, grading, benchmarks) are local.
*-workspace/

__pycache__/
*.pyc

.todos.md

# Git worktrees created inside the checkout. Each is a working directory with
# its own .git pointer, local to one machine and one branch — never content.
.claude/worktrees/
